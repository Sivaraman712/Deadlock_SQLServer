SELECT
    StatementText,
    LEN(StatementText) AS LenText,
    DATALENGTH(StatementText) AS DataLen,
    UNICODE(SUBSTRING(StatementText,LEN(StatementText)+1,1)) AS NextChar
FROM dbadb..longqrydetails
WHERE SPID = 192;

GO

SELECT
    StatementText,
    REPLACE(StatementText, NCHAR(0), '') AS CleanedText,
    UNICODE(RIGHT(REPLACE(StatementText, NCHAR(0), ''), 1)) AS LastCharAfterReplace
FROM dbadb.dbo.longqrydetails
WHERE SPID = 192;


CASE
    WHEN CHARINDEX(NCHAR(0), StatementText) > 0
    THEN LEFT(
            StatementText,
            CHARINDEX(NCHAR(0), StatementText) - 1
         )
    ELSE StatementText
END


SELECT
STRING_AGG(
    CAST(
        '<tr>' +
        '<td>' + CAST(SPID AS varchar(20)) + '</td>' +
        '<td>' + CONVERT(varchar(19),StartTime,120) + '</td>' +
        '<td>' + ElapsedTime + '</td>' +
        '<td>' + UserName + '</td>' +
        '<td>' + DatabaseName + '</td>' +
        '<td>' + LEFT(StatementText,250) + '</td>' +
        '<td>' + WaitType + '</td>' +
        '<td>' + ISNULL(StoredProcedure,'Query') + '</td>' +
        '</tr>'
    AS nvarchar(max)),
    ''
)
FROM dbadb.dbo.longqrydetails


UPDATE dbadb..longqrydetails
SET StatementText = CAST(REPLACE(CAST(StatementText AS VARBINARY(MAX)), 0x0000, 0x) AS NVARCHAR(MAX)),
    ExecutingSQL   = CAST(REPLACE(CAST(ExecutingSQL   AS VARBINARY(MAX)), 0x0000, 0x) AS NVARCHAR(MAX))
WHERE CHARINDEX(NCHAR(0), StatementText) > 0
   OR CHARINDEX(NCHAR(0), ExecutingSQL) > 0;
