SELECT
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE,
    CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE
    (TABLE_NAME = 'AT_TERMINALS'
     AND COLUMN_NAME = 'AT_TRL_LAST_UPDATED')
OR
    (TABLE_NAME = 'AT_TERMINAL_DATA'
     AND COLUMN_NAME = 'AT_TED_LAST_UPDATED');

GO
SELECT
    t.name AS TableName,
    i.name AS ClusteredIndexName,
    c.name AS ColumnName,
    ty.name AS DataType,
    c.max_length
FROM sys.tables t
JOIN sys.indexes i
    ON t.object_id = i.object_id
JOIN sys.index_columns ic
    ON i.object_id = ic.object_id
   AND i.index_id = ic.index_id
JOIN sys.columns c
    ON ic.object_id = c.object_id
   AND ic.column_id = c.column_id
JOIN sys.types ty
    ON c.user_type_id = ty.user_type_id
WHERE i.type = 1
AND t.name IN ('AT_TERMINALS','AT_TERMINAL_DATA')
ORDER BY t.name, ic.key_ordinal;
