SELECT
    t.name,
    i.type_desc
FROM sys.tables t
JOIN sys.indexes i
    ON t.object_id = i.object_id
WHERE i.index_id IN (0,1)
AND t.name IN ('AT_TERMINALS','AT_TERMINAL_DATA');

