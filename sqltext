;WITH ODI AS
(
    SELECT
        arn_id,

        MAX(CASE WHEN data_key = 'activity_line_of_trade_type' THEN data_value END) AS activityLineOfTradeType,
        MAX(CASE WHEN data_key = 'constitution' THEN data_value END) AS constitution,
        MAX(CASE WHEN data_key = 'occupation' THEN data_value END) AS occupation,
        MAX(CASE WHEN data_key = 'incorporation_registration_date' THEN data_value END) AS incorporationRegistrationDate,
        MAX(CASE WHEN data_key = 'vintage' THEN data_value END) AS vintage,
        MAX(CASE WHEN data_key = 'vintage_rating' THEN data_value END) AS vintageRating,
        MAX(CASE WHEN data_key = 'vintage_score' THEN data_value END) AS vintageScore,
        MAX(CASE WHEN data_key = 'occupation_rating' THEN data_value END) AS occupationRating,
        MAX(CASE WHEN data_key = 'occupation_score' THEN data_value END) AS occupationScore,
        MAX(CASE WHEN data_key = 'constitution_rating' THEN data_value END) AS constitutionRating,
        MAX(CASE WHEN data_key = 'constitution_score' THEN data_value END) AS constitutionScore,
        MAX(CASE WHEN data_key = 'total_static_risk_score' THEN data_value END) AS totalStaticRiskScore

    FROM isip_onboarding_data_inputs
    WHERE record_status = 1
      AND data_key IN (
            'activity_line_of_trade_type',
            'constitution',
            'occupation',
            'incorporation_registration_date',
            'vintage',
            'vintage_rating',
            'vintage_score',
            'occupation_rating',
            'occupation_score',
            'constitution_rating',
            'constitution_score',
            'total_static_risk_score'
      )
    GROUP BY arn_id
)
SELECT
    om.entity_id AS entityId,
    om.entity_name AS entityName,
    om.entity_cin AS entityCin,
    om.created_on AS onboardingDate,
    odi.activityLineOfTradeType,
    odi.constitution,
    odi.occupation,
    odi.incorporationRegistrationDate,
    odi.vintage,
    odi.vintageRating,
    odi.vintageScore,
    odi.occupationRating,
    odi.occupationScore,
    odi.constitutionRating,
    odi.constitutionScore,
    odi.totalStaticRiskScore
FROM isip_onboarding_master om
LEFT JOIN ODI
    ON ODI.arn_id = om.arn_id
WHERE om.entity_type = 'BUYER';
