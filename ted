DECLARE @sql NVARCHAR(MAX) = '';

SELECT @sql = @sql + '
USE [' + name + '];
SELECT DB_NAME() AS DatabaseName,
       CASE
            WHEN EXISTS (
                SELECT 1
                FROM sys.symmetric_keys
                WHERE name = ''##MS_DatabaseMasterKey##''
            )
            THEN ''DMK Exists''
            ELSE ''No DMK''
       END AS Status;'
FROM sys.databases
WHERE database_id > 4;

EXEC(@sql);


