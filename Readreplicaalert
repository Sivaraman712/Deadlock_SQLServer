ALTER   PROCEDURE [dbo].[DBA_Read_replica_Alert]
	@subject NVARCHAR(MAX),
	@ThresholdSeconds INT =900,
	@recipients NVARCHAR(512),
	@profile_name NVARCHAR(255)
AS
BEGIN
DROP TABLE IF EXISTS #ag_lag_results;
SET NOCOUNT ON;


DECLARE @SecondaryReplicaPattern SYSNAME = N'ReadReplicaAg%'; -- Match your read replica name(s), e.g., 'ReadReplicaAg%' or exact name

;WITH AG_Stats AS (
    SELECT 
          AGS.name                         AS AGGroupName
        , AR.replica_server_name           AS InstanceName
        , HARS.role_desc
        , DB_NAME(DRS.database_id)         AS DBName
        , DRS.database_id
        , AR.availability_mode_desc        AS SyncMode
        , DRS.synchronization_state_desc   AS SyncState
        , DRS.last_hardened_lsn
        , DRS.end_of_log_lsn
        , DRS.last_redone_lsn
        , DRS.last_hardened_time           -- On secondary: time of last hardened LSN
        , DRS.last_redone_time             -- On secondary: time of last log record redone
        , DRS.log_send_queue_size          -- KB
        , DRS.redo_queue_size              -- KB
        , DRS.log_send_rate                -- KB/sec (on primary, row per secondary)
        , DRS.redo_rate                    -- KB/sec (on secondary)
        , DRS.last_commit_time             -- Time corresponding to the last commit record
    FROM   sys.dm_hadr_database_replica_states AS DRS
    LEFT JOIN sys.availability_replicas        AS AR
           ON DRS.replica_id = AR.replica_id
    LEFT JOIN sys.availability_groups          AS AGS
           ON AR.group_id = AGS.group_id
    LEFT JOIN sys.dm_hadr_availability_replica_states AS HARS
           ON AR.group_id   = HARS.group_id
          AND AR.replica_id = HARS.replica_id
),
Pri_CommitTime AS (
    SELECT 
          AGGroupName
        , InstanceName
        , DBName
        , last_commit_time
    FROM AG_Stats
    WHERE role_desc = 'PRIMARY'
),
Sec_CommitTime AS (
    SELECT 
          AGGroupName
        , InstanceName
        , DBName
        , last_commit_time
        , log_send_queue_size   -- KB
        , redo_queue_size       -- KB
        , log_send_rate         -- KB/sec
        , redo_rate             -- KB/sec
    FROM AG_Stats
    WHERE role_desc = 'SECONDARY'
      AND InstanceName LIKE @SecondaryReplicaPattern
)
SELECT 
      p.AGGroupName
    , p.DBName                           AS [DatabaseName]
    , p.last_commit_time                 AS [Primary_Last_Commit_Time]
    , s.last_commit_time                 AS [Secondary_Last_Commit_Time]
    , DATEDIFF(SECOND, s.last_commit_time, p.last_commit_time) AS [Sync_Lag_Seconds]
    , s.log_send_queue_size              AS [Log_Send_Queue_KB]
    , s.redo_queue_size                  AS [Redo_Queue_KB]
    , s.log_send_rate                    AS [Log_Send_Rate_KBps]
    , s.redo_rate                        AS [Redo_Rate_KBps]
    , CASE 
        WHEN s.redo_rate IS NULL OR s.redo_rate <= 0 THEN NULL
        ELSE CAST(1.0 * s.redo_queue_size / s.redo_rate AS DECIMAL(18,2))
      END                                AS [Projected_Redo_Catchup_Seconds]
	  , CASE 
        WHEN s.log_send_rate IS NULL OR s.log_send_rate <= 0 THEN NULL
        ELSE CAST(1.0 * s.log_send_queue_size / s.log_send_rate AS DECIMAL(18,2))
      END                                AS [Projected_Log_Catchup_Seconds]
    , CASE 
        WHEN s.last_commit_time IS NULL THEN 'No secondary commit time'
        WHEN DATEDIFF(SECOND, s.last_commit_time, p.last_commit_time) > @ThresholdSeconds THEN 'ALERT'
        ELSE 'OK'
      END                                 AS [Status]
INTO #ag_lag_results
FROM Pri_CommitTime AS p
LEFT JOIN Sec_CommitTime AS s
  ON s.DBName = p.DBName;




IF EXISTS (SELECT 1 FROM #ag_lag_results WHERE [Status] = 'ALERT')
BEGIN
    DECLARE @body NVARCHAR(MAX) = '';
   DECLARE @AlertCount INT;
    DECLARE @MaxLagSeconds INT;
    DECLARE @ServerName NVARCHAR(255) = @@SERVERNAME;
    DECLARE @AlertTime NVARCHAR(30) = CONVERT(NVARCHAR(30), CAST(SYSDATETIME() AS DATETIME), 121);
    DECLARE @HeaderHTML NVARCHAR(MAX);
    DECLARE @SummaryHTML NVARCHAR(MAX);
    DECLARE @DetailHTML NVARCHAR(MAX);
    DECLARE @FooterHTML NVARCHAR(MAX);
    DECLARE @TableHTML NVARCHAR(MAX);

    SELECT @AlertCount = COUNT(*), @MaxLagSeconds = MAX([Sync_Lag_Seconds])
    FROM #ag_lag_results
    WHERE [Status] = 'ALERT';

    -- Build Header HTML (Email-friendly with inline styles)
    SET @HeaderHTML = '<!DOCTYPE html><html><head><meta charset="UTF-8"></head><body style="font-family: Arial, sans-serif; margin: 0; padding: 10px;">
<table width="100%" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-collapse: collapse;">
<tr><td style="background-color: #ffffff; border-top: 5px solid #0052cc; border-bottom: 2px solid #0052cc; padding: 20px;">
<h1 style="margin: 0 0 8px 0; font-size: 22px; color: #000000;">SQL Server ReadReplica Latency Alert</h1>
                           
                            <p style="margin: 5px 0; font-size: 14px; color: #bc1a1a;"><strong>Severity Level:</strong> High - Always On Lag Detected</p>
                            <div style="display: inline-block; background-color: #ff5252; color: white; padding: 8px 15px; border-radius: 20px; font-weight: bold; margin-top: 10px; font-size: 14px;">' + CAST(@AlertCount AS NVARCHAR(10)) + ' Database(s) Affected</div>
                        </td>
                    </tr>';

    
   

    -- Build Table Section
    SET @TableHTML = '                    <!-- DETAILED METRICS TABLE -->
                    <tr>
                        <td style="padding: 20px 30px;">
                            <h2 style="margin: 0 0 20px 0; font-size: 18px; color: #333;">Detailed Metrics</h2>
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; border-collapse: collapse; margin-bottom: 20px;">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Database</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Sync Lag (sec)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Log Queue (KB)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Redo Queue (KB)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Log Rate (KB/s)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Redo Rate (KB/s)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Est. Redo Catchup (sec)</th>
                                        <th style="padding: 15px; text-align: left; font-weight: bold; color: #333; border-bottom: 2px solid #d32f2f; font-size: 12px; text-transform: uppercase;">Est. Log Catchup (sec)</th>
                                    </tr>
                                </thead>
                                <tbody>';

    SELECT @TableHTML = @TableHTML +
        '<tr style="background-color: white; border-bottom: 1px solid #e0e0e0;">' +
        '<td style="padding: 12px 15px; font-size: 13px;"><strong>' + ISNULL([DatabaseName] COLLATE DATABASE_DEFAULT,'N/A') + '</strong></td>' +
        '<td style="padding: 12px 15px; font-size: 13px; color: #f57c00; font-weight: bold;">' + ISNULL(CAST([Sync_Lag_Seconds] AS NVARCHAR(30)),'N/A') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Log_Send_Queue_KB] AS NVARCHAR(30)),'0') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Redo_Queue_KB] AS NVARCHAR(30)),'0') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Log_Send_Rate_KBps] AS NVARCHAR(30)),'0.00') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Redo_Rate_KBps] AS NVARCHAR(30)),'0.00') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Projected_Redo_Catchup_Seconds] AS NVARCHAR(30)),'--') + '</td>' +
        '<td style="padding: 12px 15px; font-size: 13px;">' + ISNULL(CAST([Projected_Log_Catchup_Seconds] AS NVARCHAR(30)),'--') + '</td>' +
        '</tr>'
    FROM #ag_lag_results
    WHERE [Status] = 'ALERT';

    SET @TableHTML = @TableHTML + '                                </tbody>
                            </table>
                        </td>
                    </tr>';

    
    -- Build Footer HTML
    SET @FooterHTML = '                    <!-- FOOTER -->
                    <tr>
                        <td style="padding: 20px 30px; background-color: #fafafa; border-top: 1px solid #e0e0e0; color: #666; font-size: 12px;">
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="padding-right: 20px; padding-bottom: 15px;">
                                        <div style="color: #999; font-size: 11px; text-transform: uppercase; margin-bottom: 5px;">Server</div>
                                        <div style="color: #333;">' + @ServerName + '</div>
                                    </td>
                                    <td style="padding-right: 20px; padding-bottom: 15px;">
                                        <div style="color: #999; font-size: 11px; text-transform: uppercase; margin-bottom: 5px;">Alert Generated</div>
                                        <div style="color: #333;">' + @AlertTime + '</div>
                                    </td>
                                    <td style="padding-bottom: 15px;">
                                        <div style="color: #999; font-size: 11px; text-transform: uppercase; margin-bottom: 5px;">Threshold</div>
                                        <div style="color: #333;">' + CAST(@ThresholdSeconds AS NVARCHAR(10)) + ' second(s)</div>
                                    </td>
                                </tr>
                            </table>
                            
                            <p style="margin: 0; color: #666; line-height: 1.6;">This is an automated alert.Latency has been calculated based on the last commit time between the primary replica and the read replica. For questions, please contact the MSSQL Support Team.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>';

    -- Combine all HTML parts
    SET @body = @HeaderHTML +   @TableHTML +  @FooterHTML;
	
	-- Uncomment below to send email
    EXEC msdb.dbo.sp_send_dbmail
          @profile_name = @profile_name
        , @recipients   = @recipients
       ,@copy_recipients ='mssqlsupport@rapyder.com'
        , @subject      = @subject
        , @body         = @body
        , @body_format  = 'HTML';
        --, @importance   = 'High';

  
END

DROP TABLE IF EXISTS #ag_lag_results;
END
